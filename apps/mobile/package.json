{
  "name": "@ccsa-zora/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "build:apk": "npx eas-cli build --platform android --profile apk",
    "build:preview": "npx eas-cli build --platform android --profile preview",
    "build:aab": "npx eas-cli build --platform android --profile production",
    "build:ios": "npx eas-cli build --platform ios --profile production",
    "export:android": "expo export -p android",
    "export:ios": "expo export -p ios",
    "clean": "Remove-Item -Recurse -Force .expo -ErrorAction SilentlyContinue"
  },
  "dependencies": {
    "@ccsa-zora/api-client": "workspace:*",
    "@ccsa-zora/utils": "workspace:*",
    "@tanstack/react-query": "5.101.4",
    "expo": "~57.0.10",
    "expo-audio": "~57.0.2",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.0",
    "expo-image-picker": "~57.0.7",
    "expo-linking": "~57.0.5",
    "expo-location": "~57.0.5",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.10",
    "expo-secure-store": "~57.0.1",
    "expo-speech": "~57.0.1",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.0",
    "lucide-react-native": "^1.59.0",
    "react": "catalog:",
    "react-native": "0.86.2",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "zustand": "5.0.14",
    "expo-file-system": "~57.0.1"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "typescript": "catalog:"
  }
