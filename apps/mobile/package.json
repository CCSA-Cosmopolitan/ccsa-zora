{
  "name": "@ccsa-zora/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "build:apk": "npx eas-cli build --platform android --profile apk",
    "build:preview": "npx eas-cli build --platform android --profile preview",
    "build:aab": "npx eas-cli build --platform android --profile production",
    "build:ios": "npx eas-cli build --platform ios --profile production",
    "export:android": "expo export -p android",
    "export:ios": "expo export -p ios",
    "clean": "Remove-Item -Recurse -Force .expo -ErrorAction SilentlyContinue"
  },
  "dependencies": {
    "@ccsa-zora/api-client": "workspace:*",
    "@ccsa-zora/utils": "workspace:*",
    "@tanstack/react-query": "5.105.1",
    "expo": "~58.0.22",
    "expo-audio": "~58.0.11",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-speech": "~58.0.3",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "lucide-react-native": "^1.66.0",
    "react": "catalog:",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.11.0",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "zustand": "5.0.16",
    "expo-file-system": "~58.0.13"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "typescript": "catalog:"
  }
