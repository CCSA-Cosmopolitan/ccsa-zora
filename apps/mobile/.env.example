# Local Expo client configuration. Copy this file to apps/mobile/.env.local.
# Every EXPO_PUBLIC value is embedded in the client and must be treated as public.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
EXPO_PUBLIC_ZORA_DEMO_MODE=true
EXPO_PUBLIC_ZORA_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
EXPO_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-me
