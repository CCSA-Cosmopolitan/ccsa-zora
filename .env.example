# Administrator/deployment reference for the whole monorepo. Next.js and Expo
# use the scoped examples in apps/web and apps/mobile for local development.

# Neon pooled runtime URL using the restricted zora_app role. The hostname must
# contain -pooler. Vercel Functions use this value.
DATABASE_URL=postgresql://zora_app:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Neon direct URL using the database owner/migration role. Never expose this to
# browser or mobile code. Drizzle and psql migration scripts use this value.
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_POOL_MAX=3

# Explicit local demonstration mode. Set both values to false in production.
ZORA_ENV=development
ZORA_DEMO_MODE=true
NEXT_PUBLIC_ZORA_DEMO_MODE=true
ZORA_DEMO_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
ZORA_DEMO_USER_ID=00000000-0000-4000-8000-000000000010
NEXT_PUBLIC_ZORA_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001

# Supabase is used for authentication only. PostgreSQL data lives in Neon.
# These browser-safe values identify the Supabase Auth project.
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-on-server-only
SUPABASE_EVIDENCE_BUCKET=mrv-evidence

# Setup-only Supabase direct database URL for creating the private Storage
# bucket with db:storage:supabase. Never add this value to Vercel.
SUPABASE_DATABASE_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres

# Trusted internal services and HMAC-authenticated IoT gateways.
KGML_API_URL=http://127.0.0.1:8000
KGML_SERVICE_KEY=replace-with-at-least-32-random-characters
IOT_INGEST_SECRET=replace-with-at-least-32-random-characters
# Server-only salt used to hash access-request network fingerprints. Generate
# an independent random value; never prefix this variable with NEXT_PUBLIC_.
ACCESS_REQUEST_HASH_SALT=replace-with-at-least-32-random-characters
# Setup-only input for `pnpm iot:derive-secret`; never add it to Vercel.
ZORA_IOT_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001

# Mobile sync API. Use a reachable LAN address while developing on a device.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
EXPO_PUBLIC_ZORA_DEMO_MODE=true
EXPO_PUBLIC_ZORA_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
EXPO_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-me

# Optional public raster/vector style used by the MapLibre web module.
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# Optional production monitoring. Configure both or neither.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Only used by `pnpm smoke:production`; these are not application secrets.
ZORA_WEB_URL=https://zora.example.org
ZORA_KGML_URL=https://zora-intelligence.example.org
