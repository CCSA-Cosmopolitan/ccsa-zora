{
  "name": "@ccsa-zora/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:prepare": "node scripts/run-sql.mjs sql/0000_enable_extensions.sql",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:harden": "node scripts/run-sql.mjs sql/0001_harden_immutable_records.sql",
    "db:security": "node scripts/run-sql.mjs sql/0002_neon_security.sql",
    "db:api": "node scripts/run-sql.mjs sql/0003_api_functions.sql",
    "db:seed:demo": "node scripts/run-sql.mjs sql/0004_seed_demo.sql",
    "db:verify": "node scripts/verify-production.mjs",
    "db:studio": "drizzle-kit studio",
    "clean": "Remove-Item -Recurse -Force dist -ErrorAction SilentlyContinue",
    "db:runtime": "node scripts/run-sql.mjs sql/010_runtime.sql"
  },
  "dependencies": {
    "@ccsa-zora/utils": "workspace:*",
    "drizzle-orm": "0.45.4",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "drizzle-kit": "^0.31.8",
    "typescript": "catalog:"
  }
}
